{
  "database": {
    "url": "postgresql://user:password@localhost:5432/dbname",
    "pool_size": 20,
    "max_overflow": 10,
    "echo": false
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "debug": false,
    "reload": false,
    "workers": 4
  },
  "logging": {
    "level": "INFO",
    "file": "logs/app.log",
    "max_size": 10485760,
    "backup_count": 5
  },
  "security": {
    "secret_key": "your-secret-key",
    "algorithm": "HS256",
    "access_token_expire_minutes": 30,
    "refresh_token_expire_days": 7
  },
  "monitoring": {
    "enabled": true,
    "interval": 60,
    "metrics_dir": "metrics",
    "alerts": {
      "cpu_threshold": 80,
      "memory_threshold": 80,
      "disk_threshold": 80
    }
  },
  "resources": {
    "cpu_limit": 80,
    "memory_limit": 80,
    "disk_limit": 80,
    "network_limit": 1000
  },
  "integration": {
    "retry_attempts": 3,
    "retry_delay": 1,
    "timeout": 30,
    "max_connections": 100
  },
  "training": {
    "batch_size": 32,
    "epochs": 100,
    "learning_rate": 0.001,
    "validation_split": 0.2
  },
  "agents": {
    "demand_analyst": {
      "enabled": true,
      "model": "llama2",
      "temperature": 0.7,
      "max_tokens": 1000
    },
    "inventory_optimizer": {
      "enabled": true,
      "model": "mistral",
      "temperature": 0.5,
      "max_tokens": 1000
    },
    "supply_chain_analyst": {
      "enabled": true,
      "model": "codellama",
      "temperature": 0.6,
      "max_tokens": 1000
    },
    "pricing_analyst": {
      "enabled": true,
      "model": "llama2",
      "temperature": 0.7,
      "max_tokens": 1000
    },
    "risk_analyst": {
      "enabled": true,
      "model": "mistral",
      "temperature": 0.5,
      "max_tokens": 1000
    }
  }
} 